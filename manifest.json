{
  "manifest_version": "0.4",
  "name": "apple-ecosystem-mcp",
  "display_name": "Apple Ecosystem",
  "version": "1.1.2",
  "description": "MCP server for Apple Mail, Calendar, Contacts, Reminders, Notes, and iCloud Drive",
  "author": {
    "name": "Abhinav Agrawal",
    "email": "apple_anthropic_mcp@icloud.com",
    "url": "https://github.com/abhinavag-svg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abhinavag-svg/apple-ecosystem-mcp.git"
  },
  "server": {
    "type": "binary",
    "entry_point": "bin/apple-ecosystem-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/apple-ecosystem-mcp",
      "args": [],
      "env": {}
    }
  },
  "compatibility": {
    "platforms": ["darwin"]
  },
  "privacy_policies": [
    "https://github.com/abhinavag-svg/apple-ecosystem-mcp/blob/main/PRIVACY.md"
  ],
  "icon": "logo.svg",
  "license": "MIT"
}
